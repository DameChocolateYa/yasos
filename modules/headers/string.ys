struct String {
	data: &char;
	size: int;
  mem_busy: bool;
};

impl String {
  fun new() -> &String : "extern";
  fun nnew(borrow string: &String) : "extern";
  fun from(src: str) -> &String : "extern";

  fun set(borrow self: &String, src: str) : "extern";
  fun clone(og: &String) -> &String : "extern";
  fun clear(borrow self: &String) : "extern";

  fun find(borrow s1: &String, s2: str) -> int : "extern";

  fun cat(borrow self: &String, s2: str) : "extern";
  fun merge(borrow s1: &String, borrow s2: &String) : "extern";

  fun cut_pos(borrow self: &String) : "extern";
  fun cut_str(borrow self: &String, substr: str) : "extern";

  fun substr_raw(borrow self: &String, begin: int, end: int) -> str : "extern";
  fun substr(borrow self: &String, begin: int, end: int) -> &String : "extern";

  fun repl(borrow self: &String, old: str, new: str) : "extern";
  fun fmt(borrow self: &String, undefan) : "extern";
  fun newfmt(borrow self: &String, fmt: str, undefan) : "extern";

  fun ask(borrow self: &String, fmt: str, undefan) : "extern";

  fun destroy(self: &String) : "extern";
  fun destroym(n: int, undefan);

  fun to_str(borrow self: &String) -> str : "extern";

  fun is_empty(borrow self: &String) -> int : "extern";
  fun to_int(borrow self: &String) -> int : "extern";
  fun to_float(borrow self: &String) -> double : "extern"; #- Just the like double
  fun to_double(borrow self: &String) -> double : "extern";

  fun lower(borrow self: &String) : "extern";
  fun upper(borrow self: &String) : "extern";
  fun trim(borrow self: &String) : "extern";

  fun ch(borrow self: &String) -> char : "extern";
  fun is_whitespace(borrow self: &String) -> int : "extern";
  fun cmp_str(borrow self: &String, src: str) -> int : "extern";
  fun cmp(borrow self: &String, borrow s2: &String) -> int : "extern";

  fun size(borrow self: &String) -> int : "extern";
  fun ssize(borrow self: &String) -> int : "extern";
};

declmod string;

fun badd_nil(s: str) : "extern";
fun is_badd_nil(s: str) -> int : "extern";
fun add_badd_nil(s: str) : "extern";

fun len(s: str) -> int : "extern";

fun static_cat(dest: str, src: str) : "extern";
fun union(dest: str, src: str) : "extern";
fun new_union(dest: str, s1: str, s2: str) : "extern";
fun get_cat(s1: str, s2: str) -> str : "extern";
fun cat(s1: str, s2: str) : "extern";

fun find(string: str, substring: str) -> int : "extern";

fun cutidx(s1: str, begin: int, end: int) -> str : "extern";
fun bufcutidx(buf: &str, begin: int, end: int) : "extern";

fun cut(buf: str, begin: int, end: int) : "extern";
fun cut_substring(string: str, substring: str) : "extern";
fun bufcut(buf: &str, substr: str) : "extern";

fun sub(s1: str, begin: int, end: int) -> str : "extern";
fun bufsub(buf: &str, begin: int, end: int) : "extern";

fun to_int(s: str) : "extern";
fun to_double(s: str) : "extern";

fun cmp(s1: str, s2: str) -> int : "extern";
fun dig_to_abc(n: int) -> str : "extern";

fun is_empty(s: str) -> int : "extern";
fun is_whitespace(s: str) -> int : "extern";

fun trim(s: str) -> str : "extern";
fun buftrim(buf: &str) : "extern";

fun repl(s: str, old_sub: str, new_sub: str) -> str : "extern";
fun bufrepl(buf: &str, old_sub: str, new_sub: str) : "extern";

fun to_upper(string: str) -> str : "extern";
fun to_lower(string: str) -> str : "extern";

fun contains(string: str, substr: str) -> int : "extern";
fun contains_case(string: str, substr: str) -> int : "extern";
fun find(string: str, substr: str) -> int : "extern";

fun get_splited(string: str, delimiter: str, bufsize: &int) -> &str : "extern";

fun cpy(dest: &str, src: str) : "extern";

cnst STR_EMPTY: str = "";
cnst STR_WHITE: str = " ";
cnst STR_NULLT: str = "\0";

endmod;

declmod integer;
fun to_str(n: int) -> str : "extern";
endmod;

declmod decimal;
fun to_str(n: double, decimals: int) -> str : "extern";
endmod;

declmod character;
fun cmp(ch1: char, ch2: char) -> int : "extern";
fun cmp_int(c: char, i: i32) -> i32 : "extern";
fun to_str(c: char) -> str : "extern";
endmod;
