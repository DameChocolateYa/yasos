struct String {
	src: &str;
	size: int;
};

impl String {
	extern fun new(s: str) -> String;
	extern fun src(self: &String) -> str;
	extern fun set(self: &String, src: str);

	extern fun cat(self: &String, s2: String);
  extern fun cat_str(self: &String, s2: str);

  extern fun cut(self: &String, begin: int, end: int);
  extern fun cut_substring(self: &String, substr: String);
  extern fun cut_substr(self: &String, substr: str);

  extern fun sub(self: &String, begin: int, end: int) -> String;

  extern fun find(self: &String, substring: String) -> int;
  extern fun find_str(self: &String, substring: str) -> int;

  extern fun clean(self: &String);
	extern fun delete(self: &String);
	extern fun destroy(self: &String);
};

declmod string;

extern fun badd_nil(s: str) -> none;
extern fun is_badd_nil(s: str) -> int;
extern fun add_badd_nil(s: str) -> none;

extern fun len(s: str) -> int;

extern fun static_cat(dest: str, src: str) -> none;
extern fun union(dest: str, src: str) -> none;
extern fun new_union(dest: str, s1: str, s2: str) -> none;
extern fun get_cat(s1: str, s2: str) -> str;
extern fun cat(s1: str, s2: str) -> none;

extern fun find(string: str, substring: str) -> int;

extern fun cutidx(s1: str, begin: int, end: int) -> str;
extern fun bufcutidx(buf: &str, begin: int, end: int) -> none;

extern fun cut(buf: str, begin: int, end: int) -> none;
extern fun cut_substring(string: str, substring: str) -> none;
extern fun bufcut(buf: &str, substr: str) -> none;

extern fun sub(s1: str, begin: int, end: int) -> str;
extern fun bufsub(buf: &str, begin: int, end: int) -> none;

extern fun to_int(s: str) -> int;
extern fun to_double(s: str) -> double;

extern fun cmp(s1: str, s2: str) -> int;
extern fun dig_to_abc(n: int) -> str;

extern fun is_empty(s: str) -> int;
extern fun is_whitespace(s: str) -> int;

extern fun trim(s: str) -> str;
extern fun buftrim(buf: &str) -> none;

extern fun repl(s: str, old_sub: str, new_sub: str) -> str;
extern fun bufrepl(buf: &str, old_sub: str, new_sub: str) -> none;

extern fun to_upper(string: str) -> str;
extern fun to_lower(string: str) -> str;

extern fun contains(string: str, substr: str) -> int;
extern fun contains_case(string: str, substr: str) -> int;
extern fun find(string: str, substr: str) -> int;

extern fun get_splited(string: str, delimiter: str, bufsize: &int) -> &str;

extern fun cpy(dest: &str, src: str) -> none;

cnst STR_EMPTY: str = "";
cnst STR_WHITE: str = " ";
cnst STR_NULLT: str = "\0";

endmod;

declmod integer;
extern fun to_str(n: int) -> str;
endmod;

declmod decimal;
extern fun to_str(n: double, decimals: int) -> str;
endmod;

declmod character;
extern fun cmp(ch1: char, ch2: char) -> int;
endmod;
