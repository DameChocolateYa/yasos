#- sin, cos and tan functions wont work properly by the moment, their use is not recommended
#- It is recommended to use their equivalent in LIBC

struct Vec2 {
  x: double,
  y: double
}

struct IVec2 {
  x: i32,
  y: i32
}

struct Vec3 {
  x: double,
  y: double,
  z: double
}

struct Vec4 {
  x: double,
  y: double,
  z: double,
  w: double
}

struct Color {
	r: double,
	g: double,
	b: double,
	a: double
}

struct Color256 {
	r: i32,
	g: i32,
	b: i32,
	a: i32
}

declmod math;

inline const PI = 3.141592;
inline const E = 2.718282;

fun sqrt(x: double) -> double : "extern";
fun pow(base: double, exponent: int) -> double : "extern";
fun round(num: double, decimals: int) -> double : "extern";
fun db_to_int(n: double) -> int : "extern";
fun ceil(n: double) -> double : "extern";
fun floor(n: double) -> double : "extern";
fun abs(x: int) -> int : "extern";
fun fabs(x: double) -> double : "extern";
fun fact(x: int) -> int : "extern";
fun factd(x: double) -> double : "extern";

fun ln(x: double) -> double : "extern";
fun log(x: double, base: double) -> double : "extern";
fun log10(x: double) -> double : "extern";

fun sin(angle: double) -> double : "extern";
fun cos(angle: double) -> double : "extern";
fun tan(angle: double) -> double : "extern";

fun cosec(angle: double) -> double : "extern";
fun sec(angle: double) -> double : "extern";
fun cotan(angle: double) -> double : "extern";

fun arcsin(x: double) -> double : "extern";

fun deg2rad(deg: double) -> double : "extern";
fun rad2deg(rad: double) -> double : "extern";

fun ec_cuad(a: double, b: double, c: double, return_first: bool) -> double : "extern";

endmod;

declmod color;

fun to_256(c: Color) -> Color256 : "extern";
fun to_unit(c: Color256) -> Color : "extern";

endmod;