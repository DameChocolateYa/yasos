#- IMPORTANT: NOT RECOMMENDED TO USE, BAD IMPLEMENT (ESPECIALLY WITH STRINGS)

struct Vec {
  data: &any;
  size: int;
  capacity: int;
  elem_size: int;
};

impl Vec {
  extern fun new(elem_size: int) -> Vec;
  extern fun push(self: &Vec, new_data: &any) -> int;
  extern fun get(self: &Vec, index: int) -> &any;
  extern fun delete(this: &Vec) -> int;
};
