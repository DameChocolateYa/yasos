declmod mem;
  extern fun alloc(len: int) -> &any;
  extern fun realloc(p: &any, len: int) -> &any;
  extern fun free(p: &any) -> none;
endmod;

extern fun printf(fmt: str, undefan);
extern fun memcpy(dest: str, src: str, len: int);
extern fun memmove(begin: str, end: str, len: int);

struct Vec {
  data: &any;
  size: int;
  capacity: int;
  elem_size: int;
};

impl Vec {
  fun new(elem_size: int) -> Vec {
    var vec: Vec;
    vec.data = mem::alloc(elem_size * 2);
    vec.size = 0;
    vec.capacity = 2;
    vec.elem_size = elem_size;

    ret vec;
  } pub;

  fun push(self: &Vec, new_data: &any) -> int {
    var vec: Vec = *self;
    
    if vec.size + 1 >= vec.capacity {
      vec.capacity *= 2;
      vec.data = mem::realloc(vec.data, vec.capacity * vec.elem_size);
    }

    var data: &any = vec.data;
    memcpy(data + (vec.size + 1) * vec.elem_size, new_data, vec.elem_size);

    vec.data = data;

    *self = vec;

    ret 0;
  } pub;

  fun get(self: &Vec, index: int) -> &any {
    var vec: Vec = *self;

    if index < 0 or index > vec.size - 1 {ret nil;}
    ret vec.data + index * vec.elem_size;
  } pub;

  fun delete(this: &Vec, index: int) -> int {
    var vec: Vec = *this;
    mem::free(vec.data);
    vec.size = 0;
    vec.capacity = 0;
    vec.elem_size = 0;

    *this = vec;

    ret 0;
  } pub;
};