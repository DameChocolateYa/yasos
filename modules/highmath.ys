use "headers/std.ys";

struct Color {
	r: double,
	g: double,
	b: double,
	a: double
}

struct Color256 {
	r: i32,
	g: i32,
	b: i32,
	a: i32
}

declmod math;

fun sqrt(x: double) -> double : "extern"; #- defined in C

fun pow(base: double, exponent: int) -> double {
  let result: double = 1.;
  
  if (exponent == 0) {
    ret .0;
  }

  if exponent > 0 {
    for let i: int = 0; i < exponent; inc i {
      result *= base;
    }
  } else {
    for let i: int = 0; i < -exponent; inc i {
      result *= base;
    }
    result = 1. / result;
  }

  ret result;
} pub;

fun ln(x: double) -> double {
  if x <= .0 {
    std::perror("ERROR: ln(x) undefined for x <= 0\n");
    ret .0;
  }

  let LN2: double = 0.6931471805599453;

  let n: int = 0;
  let a: double = x;

  while a > 1.5 {
    a /= 2.;
    inc n;
  }
  while a < .5 {
    a *= 2.;
    dec n;
  }

  let y: double = (a - 1.) / (a + 1.);
  let y2: double = y * y;
  let result: double = .0;
  let term: double = y;

  for let k: int = 1; k <= 50; inc k {
    result += term / (2. * k - 1.);
    term *= y2;
  }

  ret 2. * result + n * LN2;
} pub;

fun log(x: double, base: double) -> double {
  ret math::ln(x) / math::ln(base);
} pub;

fun log10(x: double) -> double {
  ret math::log(x, 10);
} pub;

fun fact(x: int) -> int {
  let result: int = 1;
  for let i: int = x; i >= 1; dec i {
    result *= i;
  }

  ret result;
} pub;

fun factd(x: int) -> double {
  let result: double = 1.0;
  for let i: int = x; i >= 1; dec i {
    result *= i;
  }
  ret result;
} pub;

fun sin(angle: double) -> double {
  let result: double = 0.;
  let term: double = angle;

  let n: double = 0.;
  while n < 15 {
    result += term;
	let denom: double = (2.*n + 2.) * (2.*n + 3.);
	term *= (-1. * angle * angle) / denom;
    n += 1.;
  }
  
  ret result;
} pub;

fun cos(angle: double) -> double {
  let result: double = 0.0;
  let term: double = 1.0;

  let n: double = 0.0;
  while n < 15 {
  	result += term;
  	let denom: double = (2.*n + 1.) * (2.*n + 2.);
  	let frac: double = (-1.0 * angle * angle) / denom;
  	term *= frac;
  	n += 1.;
  }

  ret result;
} pub;

fun tan(angle: double) -> double {
  let s: double = math::sin(angle);
  let c: double = math::cos(angle);

  if c == 0. {
    std::perror("ERROR: undefined tan\n");
    ret 0.0; #- TODO: change for NaN
  }

  ret s / c;
} pub;

fun cosec(angle: double) -> double {
  let s: double = math::sin(angle);

  if s == 0. {
  	std::perror("ERROR: undefined sin\n");
  	ret 0.;
  }

  ret 1. / s;
} pub;

fun sec(angle: double) -> double {
  let c: double = math::cos(angle);

  if c == 0. {
  	std::perror("ERROR: undefined cos\n");
  	ret 0.;
  }

  ret 1. / c;
} pub;

fun cotan(angle: double) -> double {
  let t: double = math::tan(angle);

  if t == 0.0 {
  	std::perror("ERROR: undefined tan\n");
  	ret 0.0;
  }

  ret 1.0 / t;
} pub;

fun deg2rad(deg: double) -> double {
  ret deg * 3.141592 / 180.;
} pub;

fun rad2deg(rad: double) -> double {
  ret 180. * rad / 3.141592;
} pub;


fun ec_cuad(a: double, b: double, c: double, return_first: bool) -> double {
  let x1: double = (-(b) + math::sqrt(math::pow(b, 2) - 4. * a * c)) / (2. * a);
  let x2: double = (-(b) - math::sqrt(math::pow(b, 2) - 4. * a * c)) / (2. * a);

  if return_first {
      ret x1;
  }

  ret x2;
} pub;

fun db_to_int(n: double) -> i32 : "extern";

endmod;

declmod color;

fun to_256(c: Color) -> Color256 {
	ret Color256[
		math::db_to_int(c.r * 255.0),
		math::db_to_int(c.g * 255.0),
		math::db_to_int(c.b * 255.0),
		math::db_to_int(c.a * 255.0)
	];
} : "pub";

fun to_unit(c: Color256) -> Color {
  ret Color[
    c.r / 255.0,
    c.g / 255.0,
    c.b / 255.0,
    c.a / 255.0
  ];
} : "pub";

endmod;