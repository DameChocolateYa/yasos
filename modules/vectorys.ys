declmod mem;
extern fun alloc(size: int) -> &any;
endmod;

extern fun perror(fmt: str, undefan);
extern fun printf(fmt: str, undefan);

struct Vec {
  data: &any;
  size: int;
  capacity: int;
  elem_size: int;
  is_membusy: int;
};

impl Vec {
  #*fun new(elem_size: int) -> Vec {
    var vec: Vec;

    var data: &any = mem::alloc(2 * elem_size); #- capacity = 2 at init
    if data == nil {
      printf("Could not allocate memory for Vec\n");
      ret vec;
    }

    vec.data = data;
    vec.size = 0;
    vec.capacity = 2;
    vec.elem_size = elem_size;
    vec.is_membusy = true;

    ret vec;
  } pub;*#

  fun new(elem_size: int) -> Vec {
    var vec: Vec;

    var data: &any = mem::alloc(2 * elem_size); #- capacity = 2 at init
    if data == nil {
      printf("Could not allocate memory for Vec\n");
      ret vec;
    }

    vec.data = data;
    vec.size = 0;
    vec.capacity = 2;
    vec.elem_size = elem_size;
    vec.is_membusy = true;

    ret vec;
  } pub;

  extern fun cpy(dest: &Vec, src: Vec);

  fun clone(self: &Vec) -> Vec {
    var og: Vec = *self;
    var cloned: Vec = Vec::new(og.elem_size);
    Vec::cpy(&cloned, og);

    ret cloned;
  } pub;
};