declmod string;
extern fun cpy(dest: str, src: str, len: int);
extern fun len(s: str) -> int;
extern fun cut(buf: str, begin: int, end: int) -> str;
extern fun find(string: str, substring: str) -> int;
extern fun is_empty(string: str) -> int;
extern fun trim(string: str);
endmod;

declmod character;
extern fun cmp(c1: char, c2: char) -> int;
extern fun to_str(c: char) -> str;
endmod;

declmod mem;
extern fun alloc(len: int) -> &any;
extern fun realloc(p: &any, len: int) -> &any;
extern fun free(p: &any) -> none;
endmod;

declmod std;
extern fun perror(fmt: str, undefan);
extern fun ask(msg: str, undefan) -> str;
endmod;

extern fun printf(fmt: str, undefan);
extern fun memcpy(dest: str, src: str, len: int);
extern fun memmove(begin: str, end: str, len: int);
extern fun strcpy(dest: str, src: str);
extern fun malloc(size: int) -> &any;

struct String {
	data: &char;
	size: int;
  mem_busy: int;
};

struct Vec {
	data: &any;
	size: int;
	capacity: int;
	elem_size: int;
};

impl String {
  fun new() -> String {
    var string: String;

    string.data = mem::alloc(1);
    string.size = 0;

    if string.data == nil {
      std::perror("Could not create String\n");
      ret string;
    }

    string.mem_busy = true;

    ret string;
  } pub;

  fun from(src: str) -> String {
    var string: String = String::new();

    string.data = mem::realloc(string.data, string::len(src) + 1);

    if string.data == nil {ret string;}

    string::cpy(string.data, src);
    string.size = string::len(src);

    ret string;
  } pub;

  fun clone(self: &String) -> String {
    var string: String = *self;

    if string.data == nil or !string.mem_busy {
      std::perror("Could not clone string\n");
      ret string;
    }

    ret String::from(string.data);
  }

  fun cmp(self: &String, s2: String) -> int {
    var s1: String = *self;
    ret s1.data == s2.data and s1.mem_busy == s2.mem_busy and s1.size == s2.size;
  } pub;
};