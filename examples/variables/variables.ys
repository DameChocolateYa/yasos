#*
 * variables.ys
 * Example of creation and use of variables
*#

fun main {
	var a: i32 = 3;
	a = 2;

	var b: str = "Hola";
	var c: double = 3.141592;

	cnst d: i32 = 3; #- Wont't change its value

	"%d, %s, %.2f\n", a, b, c; #- Like C
}
