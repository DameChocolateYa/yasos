#*
 * hello_world.ys
 * Print hello world of three different ways
*#

import std; #- Only needed in print and println

fun main { #- It is not obligatory to specify in main the integer return type
	"Hello world!\n";
	std::print("Hello world!\n");
	std::println("Hello world!");

	#- You can return a integer value for main
}
