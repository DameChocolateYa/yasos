#*
 * functions.ys
 * Usage of functions
*#

#- name, arg1,  arg2      ret_type
fun sum(x: i32, y: i32) -> i32 {
	ret x + y;
}

#- If there are not args, you can leave it without parenthesis
fun print_hello {
	"Hello\n";
}

fun main {
	"%d\n", sum(2, 3);
	print_hello;
}
