#*
 * goto.ys
 * Usage of goto and labels
*#

fun main {
	var x: i32 = 1;
	
conditional:
	if x > 5 {goto end;}
	if x == 3 {
		inc x;
		goto conditional;
	}
	
	"%d\n", x;
	inc x;

	goto conditional;
end:
	"End of the program\n";
}
