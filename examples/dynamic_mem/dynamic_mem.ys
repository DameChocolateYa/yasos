#*
 * dynamic_mem.ys
 * Use of dynamic memory
*#

#*
 * Static arrays does not exist
 * However, you can use dynamic arrays or Vec struct class
*#

import mem;

#- &type can refer to pointer or dynamic array
fun interval(begin: i32, end: i32, size: &i32) -> &i32 {
	let array: &i32 = mem::alloc((end - begin + 1) * $sizeof i32);
	if array == nil {
		"Error: could not allocate memory\n";
		ret nil;
	}

	*size = 0;
	for let i: i32 = begin; i <= end; inc i {
		array[*size] = i;
		inc *size;
	}

	ret array;
}

fun main {
	let begin: i32 = 1;
	let end: i32 = 10;
	let size: i32 = 0;

	let array: &i32 = interval(begin, end, &size);
	if array == nil {ret 1;}

	for let i: i32 = 0; i < size; inc i {
		"%d\n", array[i];
	}

	mem::free(array);
}
