#*
 * references.ys
 * Use of references (also known as pointers)
*#

fun example(x: &i32, y: i32) {
	*x += y;
}

fun main {
	let x: i32 = 3;
	let y: &i32 = &x;

	"%p\n", y;
	"%d\n", *y;

	example(y, 2);
	"%d\n", *y;
}
