{
  "name": "yasos",
  "displayName": "YASOS",
  "description": "YASOS programming language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "yasos",
      "aliases": ["YASOS", "yasos"],
